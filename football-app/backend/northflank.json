{
    "apiVersion": "v1",
    "spec": {
        "kind": "DeploymentService",
        "spec": {
            "name": "football-backend",
            "billing": {
                "deploymentPlan": "nf-compute-10"
            },
            "deployment": {
                "docker": {
                    "configType": "default"
                },
                "buildpack": {
                    "configType": "default"
                },
                "external": {
                    "imagePath": ""
                }
            },
            "ports": [
                {
                    "name": "http",
                    "internalPort": 5000,
                    "public": true,
                    "protocol": "HTTP"
                }
            ],
            "runtimeEnvironment": {},
            "runtimeFiles": {}
        }
    }
}